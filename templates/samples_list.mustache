{{!
    @template report_sql/samples_list

    Browse and pick which bundled sample report sources to import.

    Classes required for JS:
    * data-region="samples-form"      the wrapping form
    * data-action="select-all"          tick every enabled sample
    * data-action="select-none"         untick every sample
    * data-region="sample-checkbox"   each per-sample checkbox

    Context variables required for this template:
    * intro - Introductory sentence (already localised).
    * single - True for radio (single-import) mode, false for checkbox (bulk) mode.
    * actionurl - Form POST target.
    * cancelurl - Where the Cancel button returns to.
    * sesskey - Session key for the POST.
    * samples - Array of rows, each with:
        * index - Stable 0-based selector for import.
        * name - Sample name.
        * description - Sample description.
        * querysql - The backing SQL (shown in a collapsible preview).
        * disabled - True when the control is disabled (bulk mode, name already present).
        * checked - True when the control should start selected.

    Example context (json):
    {
        "intro": "3 sample report sources are bundled with this plugin.",
        "single": false,
        "actionurl": "https://example.com/report/sql/samples.php",
        "cancelurl": "https://example.com/report/sql/index.php",
        "sesskey": "abc123",
        "samples": [
            {"index": 0, "name": "Active users", "description": "Users who logged in recently.", "querysql": "SELECT id FROM {user}", "disabled": false, "checked": true},
            {"index": 1, "name": "Course list", "description": "All courses.", "querysql": "SELECT id FROM {course}", "disabled": true, "checked": false}
        ]
    }
}}
<form method="post" action="{{actionurl}}" data-region="samples-form">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="import" value="1">
    {{#single}}<input type="hidden" name="single" value="1">{{/single}}

    <p>{{intro}}</p>

    {{^single}}
        <div class="d-flex gap-2 mb-2">
            <button type="button" class="btn btn-secondary btn-sm" data-action="select-all">
                {{#str}} samples:selectall, report_sql {{/str}}
            </button>
            <button type="button" class="btn btn-secondary btn-sm" data-action="select-none">
                {{#str}} samples:selectnone, report_sql {{/str}}
            </button>
        </div>
    {{/single}}

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th scope="col" class="text-center">{{#str}} samples:colselect, report_sql {{/str}}</th>
                    <th scope="col">{{#str}} samples:colname, report_sql {{/str}}</th>
                    <th scope="col">{{#str}} samples:coldesc, report_sql {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#samples}}
                    <tr{{#disabled}} class="text-muted"{{/disabled}}>
                        <td class="text-center align-middle">
                            {{#single}}
                                <button type="submit" class="btn btn-primary btn-sm" name="selected" value="{{index}}">
                                    {{#str}} samples:import, report_sql {{/str}}
                                </button>
                            {{/single}}
                            {{^single}}
                                <input type="checkbox"
                                       name="selected[]"
                                       value="{{index}}"
                                       id="sample-{{index}}"
                                       data-region="sample-checkbox"
                                       {{#checked}}checked{{/checked}}
                                       {{#disabled}}disabled{{/disabled}}>
                            {{/single}}
                        </td>
                        <td class="align-middle">
                            <label for="sample-{{index}}" class="mb-0">{{{nameicon}}}{{name}}</label>
                            <details class="mt-1">
                                <summary class="small">{{#str}} samples:previewsql, report_sql {{/str}}</summary>
                                <pre class="mt-1 mb-0"><code>{{querysql}}</code></pre>
                            </details>
                        </td>
                        <td class="align-middle">{{description}}</td>
                    </tr>
                {{/samples}}
            </tbody>
        </table>
    </div>

    <div class="d-flex gap-2">
        {{^single}}
            <button type="submit" class="btn btn-primary">
                {{#str}} samples:importselected, report_sql {{/str}}
            </button>
        {{/single}}
        <a href="{{cancelurl}}" class="btn btn-secondary">{{#str}} cancel {{/str}}</a>
    </div>
</form>
{{#js}}
require(['report_sql/samples'], function(Samples) {
    Samples.init();
});
{{/js}}
